# 管理平台前端的本地环境变量。
#
# 这个文件**可以提交**（不含任何密钥，只是一些地址开关）。
# 需要放本机私有值时，改成 `.env.local`（已被 .gitignore 忽略）。

# Vite dev server 把 /api 代理到哪个后端。
# 改了 platform_server 的监听端口时同步改这里。
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# 前端请求用的接口前缀（默认 /api，走上面的代理）。
VITE_API_BASE_URL=/api

# 页面标题，登录页与浏览器标签共用。
VITE_APP_TITLE=麻将管理平台
