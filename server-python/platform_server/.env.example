# 管理平台后端的环境变量模板。
#
# 用法（二选一）：
#   1. cp .env.example .env   然后改 .env（.env 已被 .gitignore 忽略）
#   2. 直接在 shell 里 export
#
# 注意：Django 不会自动读 `.env` 文件——本工程刻意不引 python-dotenv，
# 免得"配置到底从哪来"变得不清晰。用 `set -a; source .env; set +a`
# 或者你惯用的进程管理器注入即可。

# ---------------------------------------------------------------- 基础

# 生产必须换成随机长串，否则重启即掉登录态：
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PLATFORM_SECRET_KEY=dev-only-insecure-key-change-me-in-production

# 调试开关：生产设 0（关掉详细报错页）
PLATFORM_DEBUG=1

# 允许的 Host，逗号分隔；生产必须收窄，例如 your-host.com,10.0.0.5
PLATFORM_ALLOWED_HOSTS=*

# 日志级别：DEBUG / INFO / WARNING / ERROR
PLATFORM_LOG_LEVEL=INFO

# ---------------------------------------------------------------- 数据库
#
# **管理平台独立库**：不要指向玩家的 db_scmj。
# 首次部署需要先建库：
#   CREATE DATABASE db_scmj_admin DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

PLATFORM_DB_NAME=db_scmj_admin
PLATFORM_DB_USER=root
PLATFORM_DB_PASSWORD=li663399
PLATFORM_DB_HOST=127.0.0.1
PLATFORM_DB_PORT=3306

# 没有 MySQL 时用来跑通登录流程（测试/演示）：
#   PLATFORM_DB_ENGINE=sqlite
# PLATFORM_DB_ENGINE=mysql
# PLATFORM_SQLITE_PATH=var/platform_dev.sqlite3

# ---------------------------------------------------------------- 玩家库（只读数据源）
#
# 玩家管理要读 t_users（账号 / 昵称 / 房卡 gems / 金币）。这是**玩家库**，
# 不是上面那个管理平台库；管理平台只执行 SELECT，模型与迁移都不落在它上面。
#
# 生产强烈建议单独给一个只有 SELECT 权限的账号（例如 scmj_admin_ro），
# 而不是直接用 root。默认值跟随上面的 PLATFORM_DB_*，只服务本机开发。
#
# PLATFORM_PLAYER_DB_ENGINE=mysql
# PLATFORM_PLAYER_DB_NAME=db_scmj
# PLATFORM_PLAYER_DB_USER=scmj_admin_ro
# PLATFORM_PLAYER_DB_PASSWORD=change-me
# PLATFORM_PLAYER_DB_HOST=127.0.0.1
# PLATFORM_PLAYER_DB_PORT=3306
#
# 离线演示（无 MySQL）：玩家库退化成 SQLite 单文件，先跑
#   PLATFORM_PLAYER_DB_ENGINE=sqlite ../.venv/bin/python manage.py init_player_dev
# 造样例玩家，再启动平台。
# PLATFORM_PLAYER_SQLITE_PATH=var/player_dev.sqlite3

# ---------------------------------------------------------------- 令牌

# access 有效期（分钟）。JWT 无法主动吊销 access，缩短它才能减小泄露窗口。
PLATFORM_ACCESS_TOKEN_MINUTES=120

# refresh 有效期（天）
PLATFORM_REFRESH_TOKEN_DAYS=7

# 独立签发密钥；不设则用 SECRET_KEY
# PLATFORM_JWT_SIGNING_KEY=

# ---------------------------------------------------------------- 跨域

# 前端 dev server 地址，逗号分隔。用 Vite 代理时其实不需要 CORS，
# 这里是前端直连后端的兜底配置。
PLATFORM_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# 部署在反向代理后面时设 1，才会信任 X-Forwarded-Proto
PLATFORM_BEHIND_PROXY=0

# ---------------------------------------------------------------- 生产安全项
#
# 下面几项**只在 PLATFORM_DEBUG=0 时生效**（开发走 http，开了会打不开页面）。
# 默认值即生产推荐值，一般不用改：
#   SECURE_SSL_REDIRECT=True、SESSION/CSRF_COOKIE_SECURE=True

# 反向代理已经做了 https 跳转、应用层不需要再跳时设 0。
# PLATFORM_SECURE_SSL_REDIRECT=1

# HSTS：**默认关闭**，确认全站（含所有子域）都只走 https 之后再开。
# 开了之后浏览器会长期拒绝 http 访问，属于不可逆操作。
# 建议先设 300 观察，确认无问题再调到 31536000。
# PLATFORM_HSTS_SECONDS=0
# PLATFORM_HSTS_PRELOAD=0

# ---------------------------------------------------------------- 初始管理员
#
# `manage.py seed_admin` 在没传 --password 时会读这个变量，避免口令进 shell 历史。
# PLATFORM_ADMIN_PASSWORD=
