{
  "name": "babykylin-scmj-server",
  "version": "1.0.0",
  "private": true,
  "description": "幼麟四川麻将服务端：账号服 / 大厅服 / 游戏服三个 Node 进程，依赖用 yarn 管理（yarn.lock 为准）。",
  "packageManager": "yarn@1.22.22",
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^4.14.0",
    "log4js": "^1.0.1",
    "mysql2": "^3.24.4",
    "socket.io": "^1.4.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "account": "node dist/account_server/app.js ../configs_mac.js",
    "hall": "node dist/hall_server/app.js ../configs_mac.js",
    "game": "node dist/game_server/app.js ../configs_mac.js"
  },
  "devDependencies": {
    "@types/express": "4",
    "@types/node": "22",
    "typescript": "5"
  }
}
